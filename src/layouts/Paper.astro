---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/newsreader/index.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import { href } from '@/lib/href';

interface Props {
  title: string;
  description: string;
  current?: 'work' | 'shelf' | 'about';
  /** Caption set at the foot of the page, in the manner of a printed figure. */
  fig?: string;
}

const { title, description, current, fig } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://sindhupulugundla.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const nav = [
  { href: '/work/', label: 'Work', no: '01', key: 'work' },
  { href: '/shelf/', label: 'Shelf', no: '02', key: 'shelf' },
  { href: '/about/', label: 'About', no: '03', key: 'about' },
] as const;
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#f4efe3" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Lakshmi Sindhu Pulugundla" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="page">
      <header class="head">
        <a class="mark" href={href("/")} aria-label="Home — Lakshmi Sindhu Pulugundla">
          <span class="monogram">LSP</span>
          <span class="mark-name">Pulugundla, Lakshmi&nbsp;Sindhu</span>
        </a>
        <nav class="head-nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a href={href(item.href)} aria-current={current === item.key ? 'page' : undefined}>
                <i>{item.no}</i>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="foot">
        <div class="foot-main">
          <span class="foot-fig">{fig ?? 'Lakshmi Sindhu Pulugundla — portfolio, MMXXVI'}</span>
          <span class="foot-links">
            <a href="mailto:sindhu.pl@outlook.com">sindhu.pl@outlook.com</a>
            <a href="https://github.com/Lakshmi-Sindhu-P" rel="me noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/lakshmi-sindhu-p/" rel="me noopener">LinkedIn</a>
          </span>
        </div>
        <slot name="foot-extra" />
      </footer>
    </div>

    <style is:global>
      :root {
        --paper: #f4efe3;
        --paper-2: #efe8d8;
        --ink: #17140f;
        --ink-2: #3f3a30;
        --muted: #6d6555;
        --rust: #96432c;
        --rule: rgba(23, 20, 15, 0.14);
        --rule-soft: rgba(23, 20, 15, 0.07);
        --shell: 1280px;
      }

      * { box-sizing: border-box; }

      html { background: var(--paper); scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Newsreader Variable', Georgia, serif;
        font-size: 17px;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a { color: inherit; text-decoration: none; }
      ::selection { background: rgba(150, 67, 44, 0.18); }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
      }
      .skip:focus-visible {
        left: 12px;
        top: 12px;
        z-index: 50;
        background: var(--paper);
        border: 1px solid var(--rust);
        padding: 8px 12px;
        font-family: 'JetBrains Mono Variable', monospace;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      /* ---------- page frame ---------- */

      .page {
        min-height: 100svh;
        padding: 26px clamp(20px, 3.4vw, 56px) 22px;
        display: flex;
        flex-direction: column;
        gap: clamp(26px, 4vh, 52px);
        max-width: calc(var(--shell) + 112px);
        margin: 0 auto;
      }

      /* ---------- type primitives ---------- */

      .mono {
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 10.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .display {
        font-family: 'Fraunces Variable', Georgia, serif;
        font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 72;
        font-weight: 500;
        letter-spacing: -0.022em;
        line-height: 1.02;
      }

      .italic {
        font-family: 'Newsreader Variable', Georgia, serif;
        font-style: italic;
        letter-spacing: -0.005em;
      }

      /* ---------- header ---------- */

      .head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--rule);
      }

      .mark { display: flex; align-items: baseline; gap: 14px; }

      .monogram {
        font-family: 'Fraunces Variable', Georgia, serif;
        font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 20;
        font-weight: 600;
        font-size: 21px;
        letter-spacing: -0.01em;
      }

      .mark-name,
      .head-nav a,
      .foot {
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: 10.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .mark-name { color: var(--muted); }

      .head-nav { display: flex; gap: clamp(14px, 2.4vw, 34px); }

      .head-nav a {
        display: inline-flex;
        gap: 7px;
        align-items: baseline;
        color: var(--ink-2);
        padding-bottom: 3px;
        border-bottom: 1px solid transparent;
        transition: color 0.18s ease, border-color 0.18s ease;
      }

      .head-nav a i { font-style: normal; color: var(--muted); font-size: 9.5px; transition: color 0.18s ease; }
      .head-nav a:hover,
      .head-nav a[aria-current] { color: var(--rust); border-bottom-color: var(--rust); }
      .head-nav a:hover i,
      .head-nav a[aria-current] i { color: var(--rust); }

      /* ---------- inner-page masthead ---------- */

      .mast {
        display: flex;
        flex-direction: column;
        gap: clamp(16px, 2.6vh, 26px);
        padding-top: clamp(18px, 4vh, 44px);
      }

      .mast-kicker { margin: 0; color: var(--muted); }

      .mast-title {
        margin: 0;
        font-size: clamp(40px, 6vw, 84px);
        max-width: 22ch;
      }

      .mast-deck {
        margin: 0;
        max-width: 58ch;
        font-size: clamp(17px, 1.4vw, 20px);
        line-height: 1.55;
        color: var(--ink-2);
        text-wrap: pretty;
      }

      /* ---------- prose ---------- */

      .prose { max-width: 66ch; }
      .prose > * + * { margin-top: 1.05em; }
      .prose p { margin: 0; font-size: clamp(17px, 1.15vw, 18.5px); line-height: 1.66; text-wrap: pretty; }
      .prose h2 {
        font-family: 'Fraunces Variable', Georgia, serif;
        font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 32;
        font-weight: 500;
        font-size: 22px;
        letter-spacing: -0.012em;
        margin: 2.1em 0 0;
      }
      .prose strong { font-weight: 600; }
      .prose em { font-style: italic; }
      .prose a { border-bottom: 1px solid var(--rust); color: var(--rust); }
      .prose code {
        font-family: 'JetBrains Mono Variable', monospace;
        font-size: 0.86em;
        background: var(--paper-2);
        padding: 0.1em 0.34em;
      }

      .lede-ink { color: var(--ink-2); }

      /* ---------- footer ---------- */

      .foot {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: auto;
        padding-top: 16px;
        border-top: 1px solid var(--rule);
        color: var(--muted);
        font-size: 9.5px;
        line-height: 1.6;
        letter-spacing: 0.1em;
      }

      .foot-main {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 20px;
      }

      .foot-fig { max-width: 62ch; }
      .foot-links { display: flex; gap: 18px; }
      .foot-links a { border-bottom: 1px solid transparent; transition: color 0.18s ease, border-color 0.18s ease; }
      .foot-links a:hover { color: var(--rust); border-bottom-color: var(--rust); }

      @media (max-width: 860px) {
        .head { flex-direction: column; align-items: flex-start; gap: 12px; }
        .head-nav { flex-wrap: wrap; gap: 6px 18px; }
        .foot-main { flex-direction: column; gap: 10px; align-items: flex-start; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }
    </style>
  </body>
</html>

---
import Paper from '@/layouts/Paper.astro';
import StaffCanvas from '@/components/paper/StaffCanvas.astro';

const doors = [
  {
    href: '/work/',
    no: '01',
    title: 'Work',
    note: 'Three records, each with its numbers.',
  },
  {
    href: '/shelf/',
    no: '02',
    title: 'Shelf',
    note: 'Singing, folklore, and what I build while learning.',
  },
  {
    href: '/about/',
    no: '03',
    title: 'About',
    note: 'The longer version, in prose.',
  },
];
import { href } from '@/lib/href';
---

<Paper
  title="Lakshmi Sindhu Pulugundla — analyst, engineer, scientist, fiddler"
  description="Analyst by training, engineer by necessity, scientist by heart, fiddler, still learning the tune. Data analysis, pipelines, and a move into AI engineering."
  fig="Fig. 01 — a staff of points, drawn in the browser."
>
  <section class="overture" aria-labelledby="statement">
    <div class="staff">
      <StaffCanvas seed={2} />
    </div>

    <p class="kicker mono">Portfolio · MMXXVI</p>

    <h1 id="statement" class="statement display">
      <span>Analyst by training,</span>
      <span>engineer by necessity,</span>
      <span>scientist by heart,</span>
      <span class="fiddler italic">fiddler, still learning the tune.</span>
    </h1>

    <div class="under">
      <p class="lede">
        I take messy tables and make them answer questions — ledgers, fraud trails, forecasts,
        protein networks. Right now I am moving from analysis into AI engineering, which mostly
        means learning where models actually break: upstream, in the join.
      </p>
      <dl class="meta">
        <div><dt class="mono">Based</dt><dd>Chicago, Illinois</dd></div>
        <div><dt class="mono">Now</dt><dd>Data Analyst, Effexoft</dd></div>
        <div><dt class="mono">Moving toward</dt><dd>Data &amp; AI engineering</dd></div>
        <div><dt class="mono">Updated</dt><dd>October 2026</dd></div>
      </dl>
    </div>
  </section>

  <section class="doors" aria-label="Sections">
    {
      doors.map((door) => (
        <a class="door" href={href(door.href)}>
          <span class="door-no mono">{door.no}</span>
          <span class="door-title">{door.title}</span>
          <span class="door-note mono">{door.note}</span>
        </a>
      ))
    }
    <a class="door" href="mailto:sindhu.pl@outlook.com">
      <span class="door-no mono">04</span>
      <span class="door-title">Write to me</span>
      <span class="door-note mono">sindhu.pl@outlook.com</span>
    </a>
  </section>
</Paper>

<style>
  .overture {
    position: relative;
    padding: clamp(26px, 5vh, 58px) 0 clamp(18px, 3vh, 34px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3.4vh, 38px);
  }

  .staff {
    position: absolute;
    inset: -8% -6% auto -6%;
    height: min(88%, 560px);
    z-index: 0;
  }

  .kicker {
    position: relative;
    margin: 0;
    color: var(--muted);
    padding-left: 1px;
  }

  .statement {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(38px, 6.4vw, 86px);
    max-width: 17ch;
  }

  .statement .fiddler {
    color: var(--rust);
    font-weight: 400;
    font-size: 0.6em;
    line-height: 1.15;
    padding-left: 0.16em;
    margin-top: 0.28em;
    max-width: none;
  }

  .under {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
    padding-top: clamp(10px, 2vh, 22px);
    border-top: 1px solid var(--rule);
  }

  .lede {
    margin: 0;
    max-width: 54ch;
    font-size: clamp(16.5px, 1.35vw, 19.5px);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .meta { margin: 0; display: grid; gap: 9px; }

  .meta > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .meta dt { color: var(--muted); font-size: 9.5px; }
  .meta dd {
    margin: 0;
    color: var(--ink);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .doors {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
    margin-top: auto;
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 16px 20px 18px 0;
    border-right: 1px solid var(--rule-soft);
    transition: background 0.2s ease;
  }

  .door:last-child { border-right: 0; }
  .door + .door { padding-left: 20px; }

  .door:hover { background: var(--paper-2); }
  .door:hover .door-title { color: var(--rust); }

  .door-no { color: var(--muted); font-size: 9.5px; }

  .door-title {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 24;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }

  .door-note {
    letter-spacing: 0.08em;
    text-transform: none;
    color: var(--muted);
    font-size: 10.5px;
    line-height: 1.5;
    max-width: 26ch;
  }

  @media (max-width: 860px) {
    .statement { max-width: 100%; font-size: clamp(34px, 9vw, 54px); }
    .under { grid-template-columns: 1fr; gap: 22px; }
    .meta > div { grid-template-columns: 7rem 1fr; }
    .doors { grid-template-columns: 1fr; }
    .door, .door + .door { border-right: 0; border-bottom: 1px solid var(--rule-soft); padding: 14px 0; }
    .staff { height: 62%; inset: 0 -10% auto -10%; }
  }
</style>

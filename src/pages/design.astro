---
/**
 * /design — the comparison sheet.
 *
 * Two questions this page answers:
 *   1. Which Astryx theme should the site wear? (identity / vibe)
 *   2. Which layout should the work section use? (structure)
 *
 * Every panel is the *real* design system in that theme, so what you see is
 * what the site would ship — not a mock-up.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@astryxdesign/core/Button';
import { Badge } from '@astryxdesign/core/Badge';
import { Card } from '@astryxdesign/core/Card';
import { Stack } from '@astryxdesign/core/Stack';
import { Heading } from '@astryxdesign/core/Heading';
import { Text } from '@astryxdesign/core/Text';
const base = import.meta.env.BASE_URL;

const themes = [
  {
    id: 'report',
    name: 'Report — current',
    idea: 'Editorial document. Serif headlines, paper background, tight radii, one ink-blue accent.',
    feel: 'Considered, academic, confident. Reads like a well-set PDF.',
    type: 'Newsreader · Inter · JetBrains Mono',
    risk: 'Can feel traditional; needs the mono + metrics to stay contemporary.',
  },
  {
    id: 'neutral',
    name: 'Neutral',
    idea: 'Astryx default. Quiet greys, generous radii, product-surface feel.',
    feel: 'Neutral, safe, modern SaaS. Nothing fights the content.',
    type: 'System sans · SF Mono',
    risk: 'Interchangeable with every other portfolio built on a component library.',
  },
  {
    id: 'stone',
    name: 'Stone',
    idea: 'Warm greys. Slightly softer than neutral, still restrained.',
    feel: 'Calm, material, a little architectural.',
    type: 'System sans · SF Mono',
    risk: 'Very close to Report without the typographic personality.',
  },
  {
    id: 'butter',
    name: 'Butter',
    idea: 'Cream and yellow. Optimistic, illustrative.',
    feel: 'Friendly, warm, memorable — the opposite of a bank deck.',
    type: 'System sans · SF Mono',
    risk: 'Yellow accents can undersell technical depth; contrast needs care.',
  },
  {
    id: 'gothic',
    name: 'Gothic',
    idea: 'Dark-only. High contrast, dramatic neutrals.',
    feel: 'Late-night engineering. Striking with a single accent colour.',
    type: 'System sans · SF Mono',
    risk: 'Dark-only is a hard constraint: printing, daylight screens, and some recruiters’ taste.',
  },
] as const;

const layouts = [
  {
    id: 'document',
    label: 'A · Numbered report',
    note: 'Current build. Sections numbered like a report, metrics as figures, method folded away.',
    good: 'Scans fast; every claim has a number next to it; prints well.',
    bad: 'Text-heavy — needs strong typography to avoid reading like a CV.',
  },
  {
    id: 'split',
    label: 'B · Sticky portrait split',
    note: 'Left column pinned: portrait, name, contact, nav. Right column scrolls the evidence.',
    good: 'A recruiter always sees the name and the résumé button.',
    bad: 'Needs a good photo (you have none in the repo); costs horizontal space on mobile.',
  },
  {
    id: 'dossier',
    label: 'C · Case-file grid',
    note: 'Projects as index cards: figure first, one-line problem, one-line result, hover to expand.',
    good: 'Most visual; breaks a long page into scannable tiles.',
    bad: 'Cards flatten depth — harder to show method without a second page per project.',
  },
] as const;
---

<BaseLayout
  title="Design options — Lakshmi Sindhu Pulugundla"
  description="Theme and layout options for the portfolio, rendered with the real design system."
  noindex
>
  <header class="border-b u-hairline">
    <div class="shell flex h-14 items-center justify-between">
      <a href={base} class="eyebrow no-underline">← Back to the site</a>
      <p class="eyebrow">/design · comparison sheet</p>
    </div>
  </header>

  <main class="shell py-12">
    <h1 class="max-w-[24ch] font-[family-name:var(--font-family-heading)] text-[2rem] font-medium leading-tight tracking-[-0.02em] u-ink md:text-[2.6rem]">
      Five identities, three layouts
    </h1>
    <p class="mt-4 max-w-[64ch] text-[0.9375rem] leading-relaxed u-muted">
      Each panel below is the same components wearing a different Astryx theme — swapping
      <code class="kbd">data-astryx-theme</code> on the container is the only difference, and nested
      themes really do re-skin their subtree. Nothing here is a mock-up.
    </p>
    <p class="mt-3 max-w-[64ch] border-l-2 border-[var(--color-accent)] pl-4 text-[0.875rem] leading-relaxed u-muted">
      One finding worth knowing before you choose: <strong class="u-ink">Astryx ships a single type
      system for every theme</strong> — switching neutral → stone → butter changes colour and radius,
      not letterforms. The serif below is our own token override, which is why “Report” is the only
      panel that feels unlike a component library.
    </p>

    <!-- Identity comparison -->
    <section class="mt-14">
      <p class="eyebrow">Part 1 — Identity</p>

      <div class="mt-6 grid gap-6">
        {themes.map((theme) => (
          <article class="overflow-hidden rounded-[var(--radius-container)] border u-hairline">
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b u-hairline u-surface px-5 py-3">
              <div class="flex items-baseline gap-3">
                <span class="eyebrow text-[0.6875rem]">{theme.id}</span>
                <span class="text-[0.875rem] font-medium u-ink">{theme.name}</span>
              </div>
              <code class="text-[0.6875rem] u-muted">data-astryx-theme="{theme.id}"</code>
            </div>

            <div data-astryx-theme={theme.id} class="u-surface">
              <div class="grid gap-8 px-5 py-7 md:grid-cols-[1.4fr_1fr] md:px-7">
                <div>
                  <Heading level={3}>Consultation notes that write themselves</Heading>
                  <Text type="body" className="mt-3 block">
                    Documentation time fell from 30–35 minutes to about 18 while the neurologist
                    kept eye contact with the patient. The transcript is the product.
                  </Text>

                  <Stack direction="horizontal" gap={2} className="mt-5">
                    <Button label="Read the case" variant="primary" size="sm" />
                    <Button label="Method" variant="secondary" size="sm" />
                    <Button label="Résumé" variant="ghost" size="sm" />
                  </Stack>

                  <Stack direction="horizontal" gap={1.5} className="mt-4">
                    <Badge label="35→18 min" variant="neutral" />
                    <Badge label="96% ASR" variant="success" />
                    <Badge label="HIPAA-aware" variant="neutral" />
                  </Stack>
                </div>

                <Card variant="muted" padding={4}>
                  <Text type="label" className="block">Headline metric</Text>
                  <p class="m-0 mt-1 font-[family-name:var(--font-family-heading)] text-[2.2rem] leading-none">
                    −60%
                  </p>
                  <Text type="supporting" className="mt-2 block">
                    inventory query time across a 547K-row ledger
                  </Text>
                  <div class="mt-4 flex items-center gap-1.5">
                    <span class="chip">SQL</span>
                    <span class="chip">Power BI</span>
                  </div>
                </Card>
              </div>

              <div class="grid grid-cols-2 gap-x-6 gap-y-3 border-t u-hairline px-5 py-4 md:grid-cols-4 md:px-7">
                <div>
                  <p class="eyebrow m-0 text-[0.625rem]">Display</p>
                  <p class="m-0 mt-1" style="font-family: var(--font-family-heading); font-size: 1.5rem; line-height: 1.05; letter-spacing: -0.02em;">
                    Aa 2026
                  </p>
                </div>
                <div>
                  <p class="eyebrow m-0 text-[0.625rem]">Heading</p>
                  <p class="m-0 mt-1" style="font-family: var(--font-family-heading); font-size: 1rem; line-height: 1.2; font-weight: 500;">
                    Evidence over adjectives
                  </p>
                </div>
                <div>
                  <p class="eyebrow m-0 text-[0.625rem]">Body</p>
                  <p class="m-0 mt-1" style="font-family: var(--font-family-body); font-size: 0.8125rem; line-height: 1.4;">
                    547K rows, 35 features, one schema.
                  </p>
                </div>
                <div>
                  <p class="eyebrow m-0 text-[0.625rem]">Mono · {theme.type.split(' · ').pop()}</p>
                  <p class="m-0 mt-1" style="font-family: var(--font-family-code); font-size: 0.8125rem; line-height: 1.4; font-variant-numeric: tabular-nums;">
                    4.9M → 184K
                  </p>
                </div>
              </div>

              <div class="grid gap-4 border-t u-hairline px-5 py-4 text-[0.75rem] leading-relaxed md:grid-cols-3 md:px-7">
                <p class="m-0"><span class="eyebrow text-[0.625rem]">Idea</span><br />{theme.idea}</p>
                <p class="m-0"><span class="eyebrow text-[0.625rem]">Feels</span><br />{theme.feel}</p>
                <p class="m-0"><span class="eyebrow text-[0.625rem]">Risk</span><br />{theme.risk}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Layout comparison -->
    <section class="mt-16">
      <p class="eyebrow">Part 2 — Layout</p>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {layouts.map((layout) => (
          <article class="flex flex-col gap-3 rounded-[var(--radius-container)] border u-hairline p-5">
            <p class="eyebrow m-0">{layout.label}</p>

            <div class="wireframe" aria-hidden="true">
              {layout.id === 'document' && (
                <>
                  <div class="wf-bar w-1/4" />
                  <div class="wf-bar w-3/4 h-3" />
                  <div class="wf-rule" />
                  <div class="flex gap-2">
                    <div class="wf-col w-1/5" />
                    <div class="wf-col flex-1" />
                  </div>
                  <div class="wf-rule" />
                  <div class="flex gap-2">
                    <div class="wf-col w-1/5" />
                    <div class="wf-col flex-1" />
                  </div>
                </>
              )}
              {layout.id === 'split' && (
                <div class="flex gap-2">
                  <div class="flex w-1/3 flex-col gap-1.5">
                    <div class="wf-box h-8" />
                    <div class="wf-bar w-full" />
                    <div class="wf-bar w-3/4" />
                    <div class="wf-bar w-1/2" />
                  </div>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <div class="wf-bar w-2/3 h-2.5" />
                    <div class="wf-bar w-full" />
                    <div class="wf-bar w-5/6" />
                    <div class="wf-rule" />
                    <div class="wf-bar w-2/3 h-2.5" />
                    <div class="wf-bar w-full" />
                  </div>
                </div>
              )}
              {layout.id === 'dossier' && (
                <div class="grid grid-cols-2 gap-2">
                  <div class="wf-box h-6" />
                  <div class="wf-box h-6" />
                  <div class="wf-box h-6" />
                  <div class="wf-box h-6" />
                </div>
              )}
            </div>

            <p class="m-0 text-[0.8125rem] leading-relaxed u-muted">{layout.note}</p>
            <p class="m-0 text-[0.75rem] leading-relaxed">
              <span class="u-accent">+</span> {layout.good}
            </p>
            <p class="m-0 text-[0.75rem] leading-relaxed u-muted">
              <span aria-hidden="true">−</span> {layout.bad}
            </p>
          </article>
        ))}
      </div>
    </section>

    <p class="mt-14 max-w-[62ch] text-[0.8125rem] leading-relaxed u-muted">
      Current recommendation: keep <strong class="u-ink">Report</strong> as the identity, because a
      data analyst's differentiator is evidence, not decoration — and add layout{' '}
      <strong class="u-ink">B</strong>'s sticky name rail on desktop once there is a portrait worth
      pinning. Dark mode is a hand-built variant of Report, not Astryx's Gothic theme.
    </p>
  </main>

  <style>
    .wireframe {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      background: var(--color-background-muted);
      min-height: 9rem;
      flex: 1;
    }
    .wf-bar {
      height: 0.3rem;
      border-radius: 1px;
      background: color-mix(in srgb, var(--color-text-primary) 28%, transparent);
    }
    .wf-rule {
      height: 1px;
      background: var(--color-border-emphasized);
      margin: 0.125rem 0;
    }
    .wf-col {
      height: 2.5rem;
      border-radius: 2px;
      background: color-mix(in srgb, var(--color-text-primary) 12%, transparent);
    }
    .wf-box {
      border-radius: 2px;
      border: 1px solid var(--color-border-emphasized);
      background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
    }
  </style>
</BaseLayout>

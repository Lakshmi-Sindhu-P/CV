---
import Paper from '@/layouts/Paper.astro';
import StaffRule from '@/components/paper/StaffRule.astro';
import { records, workRecords, independentRecords, alsoShipped } from '@/data/records';
import { href } from '@/lib/href';
---

<Paper
  title="Work — Lakshmi Sindhu Pulugundla"
  description={`${records.length} records: a 547K-row procurement pipeline, a pruned protein network, a rebuilt regression on 10,000 tracks, and an independent clinical note assistant.`}
  current="work"
  fig={`Fig. 02 — the ledger: ${records.length} records, with the numbers they moved.`}
>
  <header class="mast">
    <p class="mast-kicker mono">01 — Work · {records.length} records</p>
    <h1 class="mast-title display">Every project carries its number</h1>
    <p class="mast-deck">
      Every figure on this page comes from a shipped analysis or from a measurement taken at the
      time. Where something did not work, the record says so — a portfolio that only reports success
      is a résumé with longer sentences.
    </p>
  </header>

  <section class="ledger" aria-label="Employed and client work">
    <h2 class="mono ledger-head">Employed and client work</h2>
    {
      workRecords.map((record) => (
        <a class="row" href={href(`/work/${record.slug}/`)}>
          <span class="row-rail">
            <span class="mono row-no">{record.index}</span>
            <span class="mono row-org">{record.org}</span>
            <span class="mono row-period">{record.period}</span>
          </span>
          <span class="row-body">
            <span class="row-title">{record.title}</span>
            <span class="row-deck">{record.deck}</span>
            <span class="row-chips">
              {record.chips.map((chip) => (
                <span class="chip mono">{chip}</span>
              ))}
            </span>
          </span>
          <span class="row-go mono" aria-hidden="true">Read →</span>
        </a>
      ))
    }
  </section>

  <section class="ledger ledger-independent" aria-label="Independent projects">
    <h2 class="mono ledger-head">Independent</h2>
    {
      independentRecords.map((record) => (
        <a class="row" href={href(`/work/${record.slug}/`)}>
          <span class="row-rail">
            <span class="mono row-no">{record.index}</span>
            <span class="mono row-org">Own project</span>
            <span class="mono row-period">{record.period}</span>
          </span>
          <span class="row-body">
            <span class="row-title">{record.title}</span>
            <span class="row-deck">{record.deck}</span>
            <span class="row-chips">
              {record.chips.map((chip) => (
                <span class="chip mono">{chip}</span>
              ))}
            </span>
          </span>
          <span class="row-go mono" aria-hidden="true">Read →</span>
        </a>
      ))
    }
  </section>

  <section class="also" aria-label="Also shipped">
    <h2 class="mono also-head">Also shipped</h2>
    <ul class="also-list">
      {
        alsoShipped.map((item) => (
          <li>
            <span class="also-title">{item.title}</span>
            <span class="also-detail">{item.detail}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="fin">
    <StaffRule notes={[3, 1, 2, 4, 2]} width={220} label="fin — 01" />
  </div>
</Paper>

<style>
  .mast { padding-bottom: clamp(20px, 4vh, 40px); }

  .ledger-head {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 26px 0 10px;
    border-top: 1px solid var(--rule);
  }

  .ledger-independent .ledger-head { border-top: 0; padding-top: 46px; }

  .ledger {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr) 5rem;
    gap: clamp(16px, 3vw, 44px);
    padding: clamp(22px, 3vh, 32px) 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    transition: background 0.18s ease;
  }

  .row:hover { background: var(--paper-2); }
  .row:hover .row-title { color: var(--rust); }

  .row-rail { display: flex; flex-direction: column; gap: 6px; }

  .row-no { font-size: 11px; color: var(--rust); }
  .row-org { color: var(--ink-2); font-size: 10px; }
  .row-period { color: var(--muted); font-size: 10px; }

  .row-body { display: flex; flex-direction: column; gap: 9px; }

  .row-title {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-variation-settings: 'SOFT' 30, 'WONK' 0, 'opsz' 36;
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.018em;
    line-height: 1.12;
    transition: color 0.18s ease;
    text-wrap: balance;
  }

  .row-deck {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .row-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 3px; }

  .chip {
    font-size: 9.5px;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .row-go {
    font-size: 9.5px;
    color: var(--muted);
    text-align: right;
    transition: color 0.18s ease;
  }
  .row:hover .row-go { color: var(--rust); }

  .also {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: clamp(34px, 6vh, 54px);
    padding-top: 26px;
    border-top: 1px solid var(--rule);
  }

  .also-head { margin: 0; color: var(--muted); font-size: 10px; }

  .also-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    column-gap: clamp(20px, 4vw, 56px);
  }

  .also-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 11px 0;
    border-top: 1px solid var(--rule-soft);
  }

  .also-title { font-size: 15.5px; }
  .also-detail { font-size: 13px; color: var(--muted); line-height: 1.5; }

  .fin { display: flex; justify-content: flex-end; padding-top: 6px; }

  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr; gap: 10px; }
    .row-rail { flex-direction: row; gap: 14px; align-items: baseline; }
    .row-go { text-align: left; }
  }
</style>

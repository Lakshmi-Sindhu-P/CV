---
import Paper from '@/layouts/Paper.astro';
import { href } from '@/lib/href';
---

<Paper
  title="Page not found — Lakshmi Sindhu Pulugundla"
  description="That page is not in the dataset."
  fig="Fig. 404 — discarded during quality filtering."
>
  <section class="missing">
    <p class="mono kicker">Error 404</p>
    <h1 class="display">No rows matched.</h1>
    <p class="deck">
      The page you asked for is not in this dataset. Either the link is stale, or I pruned it —
      everything here is meant to survive a review.
    </p>
    <nav class="links" aria-label="Useful pages">
      <a href={href("/")}>Front page</a>
      <a href={href("/work/")}>Work</a>
      <a href={href("/shelf/")}>Shelf</a>
      <a href={href("/about/")}>About</a>
      <a href="mailto:sindhu.pl@outlook.com">sindhu.pl@outlook.com</a>
    </nav>
  </section>
</Paper>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(40px, 12vh, 120px) 0;
    max-width: 54ch;
  }

  .kicker { margin: 0; color: var(--rust); }

  h1 {
    margin: 0;
    font-size: clamp(40px, 7vw, 88px);
    max-width: 12ch;
  }

  .deck { margin: 0; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: var(--ink-2); }

  .links { display: flex; flex-wrap: wrap; gap: 20px; padding-top: 10px; }

  .links a {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 3px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .links a:hover { color: var(--rust); border-bottom-color: var(--rust); }
</style>

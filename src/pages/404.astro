---
/**
 * 404 — kept in the report's voice rather than a generic apology.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found — Lakshmi Sindhu Pulugundla"
  description="That page does not exist."
  noindex
>
  <main id="main" class="shell flex min-h-screen flex-col justify-center py-20">
    <p class="eyebrow">Fig. 404 — discarded during quality filtering</p>

    <h1 class="mt-8 font-[family-name:var(--font-family-heading)] text-[clamp(3rem,10vw,6rem)] font-normal leading-[0.95] tracking-[-0.03em] u-ink">
      No rows
      <br />
      matched.
    </h1>

    <p class="mt-8 max-w-[52ch] text-[0.9375rem] leading-relaxed u-muted">
      The page you asked for is not in this dataset. Either the link is stale, or I pruned it —
      everything here is meant to survive review.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a href={base} class="link-underline text-[0.9375rem]">← Back to the front page</a>
      <a href={`mailto:${profile.email}`} class="link-underline text-[0.9375rem] u-muted">
        {profile.email}
      </a>
    </div>

    <p class="mt-16 font-[family-name:var(--font-family-code)] text-[0.6875rem] u-muted">
      {profile.name} · {profile.location}
    </p>
  </main>
</BaseLayout>

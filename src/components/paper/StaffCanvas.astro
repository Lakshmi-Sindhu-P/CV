---
/**
 * The staff of points: a five-line staff drawn from dots, with sparse notes on
 * the lines. Pointer proximity brightens the field. Static when the reader has
 * asked for reduced motion.
 */
interface Props {
  /** Shifts the note pattern so two staves on one page do not repeat. */
  seed?: number;
  class?: string;
}

const { seed = 0, class: className } = Astro.props;
const id = `staff-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['staff-field', className]} aria-hidden="true">
  <canvas id={id} data-seed={seed}></canvas>
</div>

<style>
  .staff-field {
    position: absolute;
    inset: -8% -6% auto -6%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 76%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 76%, transparent);
  }

  canvas { display: block; width: 100%; height: 100%; }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function mount(canvas: HTMLCanvasElement) {
    const seed = Number(canvas.dataset.seed ?? 0);
    const start = performance.now();
    let pointer = { x: -9999, y: -9999 };
    let raf = 0;

    function draw(t: number) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (!w || !h) return;
      if (canvas.width !== Math.floor(w * dpr) || canvas.height !== Math.floor(h * dpr)) {
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
      }
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const gap = 17;
      const cols = Math.ceil(w / gap) + 1;
      const rows = Math.ceil(h / gap) + 1;
      const time = reduced ? 0 : (t - start) / 1000;

      const staffGap = 54;
      const staffTop = Math.round(h * 0.44);
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(23, 20, 15, 0.065)';
      for (let i = 0; i < 5; i++) {
        const y = staffTop + i * staffGap + 0.5;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * gap;
          const y = r * gap;
          const wave =
            Math.sin(x * 0.012 + time * 0.5) * 0.5 +
            Math.sin(y * 0.02 - time * 0.32) * 0.35 +
            Math.sin((x + y) * 0.006 + time * 0.18) * 0.3;

          const lineIdx = Math.round((y - staffTop) / staffGap);
          const onLine =
            lineIdx >= 0 && lineIdx < 5 && Math.abs(y - (staffTop + lineIdx * staffGap)) < 3;
          const isNote = onLine && (c + lineIdx * 4 + seed * 3) % 11 === 0;

          let radius = 0.7 + (wave + 1) * 0.45;
          let alpha = 0.06 + (wave + 1) * 0.07;
          if (onLine) { radius = 0.85; alpha = 0.12; }
          if (isNote) { radius = 2.9 + (wave + 1) * 0.7; alpha = 0.46; }

          const d = Math.hypot(x - pointer.x, y - pointer.y);
          if (d < 200) {
            const k = 1 - d / 200;
            radius += k * 2.1;
            alpha += k * 0.55;
          }

          ctx.beginPath();
          ctx.arc(x, y, radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(150, 67, 44, ${Math.min(alpha, 0.72).toFixed(3)})`;
          ctx.fill();
        }
      }
    }

    function loop(t: number) {
      draw(t);
      raf = requestAnimationFrame(loop);
    }

    canvas.addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    });
    canvas.addEventListener('pointerleave', () => { pointer = { x: -9999, y: -9999 }; });

    new ResizeObserver(() => draw(performance.now())).observe(canvas);

    if (reduced) {
      draw(performance.now());
    } else {
      raf = requestAnimationFrame(loop);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(loop);
      });
    }
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-seed]').forEach(mount);
</script>
